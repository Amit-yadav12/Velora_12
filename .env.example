# Copy to .env for local development or set in your hosting provider.
# Leave these blank for the isolated local demo. Never commit real secrets.
# VITE_* values are shipped to browsers and MUST be public/publishable.

# Exact deployed origin, no path or trailing slash. Used in QR/email links.
APP_URL=
VITE_APP_URL=
# Optional comma-separated browser origins in addition to APP_URL.
ALLOWED_ORIGINS=

# Supabase project: both browser values must be set to use real Auth/Storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only: URL plus service-role key; do not prefix the key with VITE_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps: a browser-restricted Maps JavaScript + Maps Embed key and a separate
# server-side key for Geocoding, Places (Legacy) and Distance Matrix (Legacy).
# Without them, map tiles use OpenStreetMap when reachable; address search and
# live Places/travel results are unavailable rather than invented.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Required for REAL bookings and ticket verification; >= 32 random characters.
# Generate a secret with: openssl rand -base64 32
# Keep stable across deploys: rotation invalidates previously signed tickets.
QR_SIGNING_SECRET=
# Required for global scheduled reminders; generate another independent secret.
CRON_SECRET=

# Optional email delivery. Provider acceptance does not prove inbox delivery.
EMAIL_FROM=Velora <bookings@yourdomain.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_RELAY_URL=

# Optional server-side Google Calendar sync (refresh-token chain preferred).
# One shared calendar for the whole deployment, not per-business OAuth;
# see DEPLOY.md before enabling for multiple independent businesses.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Optional conversational reply enrichment; booking decisions do not use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional managed database restore hook (deployment-specific).
FULLSTACK_RESTORE_API_URL=
FULLSTACK_PROJECT_REF=
