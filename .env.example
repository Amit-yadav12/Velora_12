# ============================================================================
# Velora AI OS — environment template. Copy to .env (dev) or set in Vercel.
# NEVER commit real secrets. Frontend (VITE_*) vars are public by design —
# only anonymous/publishable keys may use that prefix.
# ============================================================================

# --- App identity (used for QR verification links, emails, callbacks) ---
APP_URL=https://velora-ai-in.netlify.app
VITE_APP_URL=https://velora-ai-in.netlify.app
VITE_API_BASE_URL=

# --- Supabase (database + auth + realtime) ---
# Frontend: publishable values only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only (Vercel env, never VITE_ prefixed):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Google sign-in (custom OAuth proxy flow) ---
# Frontend: client id is public; the proxy URL must be an authorized redirect.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://your-auth-proxy/callback
# Google Authorized JavaScript origins must include: APP_URL and http://localhost:5173 (dev)
# Google Authorized redirect URIs must include: VITE_GOOGLE_AUTH_PROXY

# --- Google Maps ---
# Enables LIVE business discovery in /api/places. Embeds/directions work keyless.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Booking security ---
# HMAC secret for signed QR verification tokens. REQUIRED in production
# (generate: openssl rand -base64 32). Dev falls back with a loud warning.
QR_SIGNING_SECRET=
# Shared secret protecting the reminder cron endpoint (Bearer token).
CRON_SECRET=

# --- Email delivery (first configured provider wins) ---
EMAIL_FROM=Velora <bookings@yourdomain.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_RELAY_URL=

# --- Google Calendar (server-side booking sync; optional) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=

# --- AI concierge (optional; rule-based fallback works without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Admin alerts (optional) ---
ADMIN_EMAIL=

# --- Supabase auto-restore (optional, managed infra) ---
FULLSTACK_RESTORE_API_URL=
FULLSTACK_PROJECT_REF=
