# ============================================================================
# VELORA — Production Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ============================================================================

# ---------- Supabase (Postgres + Realtime + Storage) ----------
# Server-side (API routes)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, bypasses RLS

# Client-side (Vite frontend)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- Firebase Auth (optional alternative / RBAC) ----------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-app-id
# Service account for verifying ID tokens server-side (base64-encoded JSON):
FIREBASE_SERVICE_ACCOUNT_B64=base64-encoded-service-account-json

# ---------- Google OAuth 2.0 (Sign-in) ----------
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://your-oauth-proxy/callback
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---------- Google Calendar API (OAuth 2.0 sync) ----------
# Access token obtained via OAuth 2.0 authorization code flow (calendar scope).
GOOGLE_CALENDAR_ACCESS_TOKEN=ya29.your-oauth-access-token
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary

# ---------- Google Maps Platform ----------
# Enable: Distance Matrix API, Geocoding API, Maps JavaScript API.
GOOGLE_MAPS_API_KEY=your-server-maps-key
VITE_GOOGLE_MAPS_API_KEY=your-browser-maps-key

# ---------- AI: OpenAI / Gemini ----------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# ---------- Email Delivery (choose one; system falls back gracefully) ----------
# ⚡ TO MAKE CONFIRMATION EMAILS ACTUALLY ARRIVE IN GMAIL:
#   1. Sign up free at https://resend.com (100 emails/day, ~30 seconds).
#   2. Create an API key, paste it below as RESEND_API_KEY.
#   3. Add BOTH RESEND_API_KEY and EMAIL_FROM to your Vercel project env vars.
#   4. Redeploy. Bookings will then email the customer + admin automatically.
# Until a key is set, the app shows a one-tap "Send confirmation to my Gmail"
# button on the success screen so the email is never lost.
EMAIL_FROM=Velora <onboarding@resend.dev>
# Resend (recommended)
RESEND_API_KEY=re_your-resend-key
# Optional: where admin/business booking alerts go
ADMIN_EMAIL=you@gmail.com
# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-key
# Generic SMTP
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# ---------- Realtime / Cache (optional) ----------
REDIS_URL=redis://localhost:6379

# ---------- App ----------
APP_URL=https://app.velora.ai
APP_ENV=production
